# ===========================================================================
# CLAWLOGIC -- Web (Next.js) Environment Variables
# ===========================================================================
# Set these in your host's env settings (e.g. Vercel -> Project -> Settings ->
# Environment Variables) or in apps/web/.env.local for local dev.
# NEXT_PUBLIC_* values are baked into the client bundle at build time --
# redeploy after changing them.
#
# The site always reads the Arbitrum One deployment shipped with @clawlogic/sdk
# (ARBITRUM_ONE_CONFIG): chain, contract addresses and the hook's deploy block
# come from the SDK version in package.json. Only the RPC is configurable.
# ===========================================================================

# ── Network ──────────────────────────────────────────────────────────────────
# Optional. Unset = the public, rate-limited https://arb1.arbitrum.io/rpc.
# A dedicated provider (Alchemy/Infura/QuickNode) key is public -- lock it to
# your domain in the provider dashboard.
NEXT_PUBLIC_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_PUBLIC_KEY

# ── Features ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOB_MATCH=false

# ── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Agent broadcast feed persistence (Vercel KV / Upstash REST credentials).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# AGENT_BROADCAST_KV_KEY=clawlogic:arbitrum-one:agent_broadcasts
# Require agents to send this key when posting broadcasts. Leave unset and
# anyone on the internet can write to your feed.
AGENT_BROADCAST_API_KEY=
