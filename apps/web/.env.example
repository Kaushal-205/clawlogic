# ===========================================================================
# CLAWLOGIC -- Web (Next.js) Environment Variables
# ===========================================================================
# Set these in your host's env settings (e.g. Vercel -> Project -> Settings ->
# Environment Variables) or in apps/web/.env.local for local dev.
# NEXT_PUBLIC_* values are baked into the client bundle at build time --
# redeploy after changing them. Unset values fall back to Arbitrum Sepolia.
# ===========================================================================

# ── Network ──────────────────────────────────────────────────────────────────
# Arbitrum One mainnet = 42161, Arbitrum Sepolia = 421614
NEXT_PUBLIC_CHAIN_ID=42161
# Use a dedicated provider (Alchemy/Infura/QuickNode) -- this key is public.
# Lock it to your domain in the provider dashboard.
NEXT_PUBLIC_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_PUBLIC_KEY

# ── CLAWLOGIC contracts (from packages/contracts/deployments/arbitrum-one.json)
NEXT_PUBLIC_AGENT_REGISTRY=0x_DEPLOYED_AGENT_REGISTRY
NEXT_PUBLIC_PREDICTION_MARKET_HOOK=0x_DEPLOYED_PREDICTION_MARKET_HOOK

# ── External contracts (Arbitrum One canonical deployments) ──────────────────
NEXT_PUBLIC_V4_POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
NEXT_PUBLIC_UMA_OOV3=0xa6147867264374F324524E30C02C331cF28aa879

# ── Features ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOB_MATCH=false

# ── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Agent broadcast feed persistence (Vercel KV / Upstash REST credentials).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# AGENT_BROADCAST_KV_KEY=clawlogic:agent_broadcasts
# Require agents to send this key when posting broadcasts. Leave unset and
# anyone on the internet can write to your feed.
AGENT_BROADCAST_API_KEY=
