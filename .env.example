# ===========================================================================
# CLAWLOGIC -- Root Environment Variables
# ===========================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
#
# Each package may also have its own .env.example with package-specific vars.
# See: packages/contracts/.env.example, apps/agent/.env.example
# ===========================================================================

# ── RPC (Arbitrum One mainnet -- use a dedicated provider) ────────────────────
ARBITRUM_ONE_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Deployer / Admin ─────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY_HERE

# ── Agent demo wallets ───────────────────────────────────────────────────────
AGENT_ALPHA_PRIVATE_KEY=0x_YOUR_AGENT_ALPHA_PRIVATE_KEY_HERE
AGENT_BETA_PRIVATE_KEY=0x_YOUR_AGENT_BETA_PRIVATE_KEY_HERE

# ── Human wallet (for rejection demo) ───────────────────────────────────────
HUMAN_PRIVATE_KEY=0x_YOUR_HUMAN_WALLET_PRIVATE_KEY_HERE

# ── Verification ─────────────────────────────────────────────────────────────
# Etherscan API v2: one key verifies on every Etherscan-supported chain
# (including Arbitrum One). Create it at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# ── Arbitrum One MAINNET ─────────────────────────────────────────────────────
# Deploy.s.sol treats chain 42161 as production: it never deploys mocks,
# requires UMA_OOV3 + UMA_BOND_CURRENCY, and requires DEFAULT_LIVENESS >= 7200.
# Use a dedicated RPC provider, and a hardware wallet / multisig-funded
# deployer (e.g. `forge script ... --ledger`) rather than a raw private key.
# Canonical Arbitrum One deployments (verified against Uniswap docs and
# UMAprotocol/protocol packages/core/networks/42161.json):
V4_POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
UMA_OOV3=0xa6147867264374F324524E30C02C331cF28aa879
#
# Bond currency must be on UMA's collateral whitelist
# (AddressWhitelist 0x02D65fb01d3d88127dF19838902ba42c6239c0Fd -- check with
# `cast call <whitelist> "isOnWhitelist(address)(bool)" <token>`):
# WETH (the live deployment's bond currency):
UMA_BOND_CURRENCY=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
# UMA_BOND_CURRENCY=0xaf88d065e77c8cC2239327C5EDb3A432268e5831   # native USDC
#
DEFAULT_LIVENESS=7200
#
# Revenue + admin (applied by Deploy.s.sol right after deployment):
# PROTOCOL_OWNER=0x_YOUR_SAFE     # hook admin; must call acceptOwnership() (Ownable2Step)
# TREASURY=0x_YOUR_SAFE           # receives protocol fees (default: deployer)
# PROTOCOL_FEE_BPS=100            # 1% of every AMM trade to the treasury (max 10% total)
# LP_FEE_BPS=100                  # 1% of every AMM trade to liquidity providers
# MARKET_CREATION_FEE_WEI=0       # flat fee per market, max 0.1 ETH
# Canonical ERC-8004 IdentityRegistry (same address on Arbitrum One, Base, Ethereum...):
# holders can trade without a separate CLAWLOGIC registration.
# ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# ENS_REGISTRY=        # leave unset: ENS lives on Ethereum L1, not Arbitrum
# PHALA_VERIFIER=      # leave unset until a production verifier exists

# ── Circle Arc Testnet ─────────────────────────────────────────────────────
# Arc is Circle's EVM-compatible L1 with USDC as native gas token.
# Faucet: https://faucet.circle.com
# Explorer: https://testnet.arcscan.app
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002

# Arc block explorer API key (for contract verification)
ARCSCAN_API_KEY=YOUR_ARCSCAN_API_KEY_HERE

# ── Deployed contract addresses (populated after deployment) ─────────────────
# -- Arbitrum One (packages/contracts/deployments/arbitrum-one.json) --
# AGENT_REGISTRY=0x6Ecc60F604d08b19fBd5eCCDc61b9DFb4fFca9F8
# PREDICTION_MARKET_HOOK=0x55cB6476a7B4DBe048407Cf4058Af3A9f8408880
#
# -- Arc Testnet --
# ARC_AGENT_REGISTRY=0x_DEPLOYED_ARC_AGENT_REGISTRY_HERE
# ARC_PREDICTION_MARKET_HOOK=0x_DEPLOYED_ARC_HOOK_HERE
# ARC_MOCK_OOV3=0x_DEPLOYED_ARC_MOCK_OOV3_HERE
# ARC_BOND_CURRENCY=0x_DEPLOYED_ARC_BOND_CURRENCY_HERE
