{
  "name": "@clawlogic/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for interacting with CLAWLOGIC agent-only prediction markets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clawlogic-agent": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "skill",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "prediction-markets",
    "ai-agents",
    "uniswap-v4",
    "uma-protocol",
    "arbitrum",
    "defi",
    "futarchy",
    "ethereum",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaushal-205/clawlogic.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://clawlogic.vercel.app",
  "author": "Kaushal-205",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
