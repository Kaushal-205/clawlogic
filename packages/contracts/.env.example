# ===========================================================================
# CLAWLOGIC -- Contracts Environment Variables
# ===========================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# ===========================================================================

# ── RPC ──────────────────────────────────────────────────────────────────────
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Deployer ─────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY_HERE

# ── Agent demo wallets ───────────────────────────────────────────────────────
AGENT_ALPHA_PRIVATE_KEY=0x_YOUR_AGENT_ALPHA_PRIVATE_KEY_HERE
AGENT_BETA_PRIVATE_KEY=0x_YOUR_AGENT_BETA_PRIVATE_KEY_HERE
HUMAN_PRIVATE_KEY=0x_YOUR_HUMAN_WALLET_PRIVATE_KEY_HERE

# ── Verification ─────────────────────────────────────────────────────────────
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY_HERE

# ── External contract addresses (Arbitrum Sepolia) ───────────────────────────
# Uniswap V4 PoolManager on Arbitrum Sepolia.
# Check https://docs.uniswap.org/contracts/v4/deployments for the latest address.
V4_POOL_MANAGER=0x_POOL_MANAGER_ADDRESS_HERE

# UMA Optimistic Oracle V3 on Arbitrum Sepolia.
# Check https://docs.uma.xyz/resources/network-addresses for the latest address.
UMA_OOV3=0x_UMA_OOV3_ADDRESS_HERE

# UMA bond currency (e.g. WETH on Arbitrum Sepolia).
UMA_BOND_CURRENCY=0x_BOND_CURRENCY_ADDRESS_HERE

# ── Arbitrum One MAINNET ─────────────────────────────────────────────────────
# Deploy.s.sol treats chain 42161 as production: it never deploys mocks,
# requires UMA_OOV3 + UMA_BOND_CURRENCY, and requires DEFAULT_LIVENESS >= 7200.
# Use a dedicated RPC provider, and a hardware wallet / multisig-funded
# deployer (e.g. `forge script ... --ledger`) rather than a raw private key.
# ARBITRUM_ONE_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# Canonical Arbitrum One deployments (verified against Uniswap docs and
# UMAprotocol/protocol packages/core/networks/42161.json):
# V4_POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
# UMA_OOV3=0xa6147867264374F324524E30C02C331cF28aa879
#
# Bond currency must be on UMA's collateral whitelist
# (AddressWhitelist 0x02D65fb01d3d88127dF19838902ba42c6239c0Fd -- check with
# `cast call <whitelist> "isOnWhitelist(address)(bool)" <token>`):
# UMA_BOND_CURRENCY=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1   # WETH
# UMA_BOND_CURRENCY=0xaf88d065e77c8cC2239327C5EDb3A432268e5831   # native USDC
#
# DEFAULT_LIVENESS=7200
# ENS_REGISTRY=        # leave unset: ENS lives on Ethereum L1, not Arbitrum
# PHALA_VERIFIER=      # leave unset until a production verifier exists

# ── Optional overrides ──────────────────────────────────────────────────────
# UMA assertion liveness in seconds (default: 120 for demo).
# DEFAULT_LIVENESS=120

# ── CreateMarket.s.sol helper (set after deployment) ────────────────────────
# AGENT_REGISTRY=0x_DEPLOYED_AGENT_REGISTRY_HERE
# PREDICTION_MARKET_HOOK=0x_DEPLOYED_HOOK_HERE
# MARKET_DESCRIPTION="Will the next Arbitrum Sepolia block basefee exceed 0.1 gwei?"
# MARKET_OUTCOME1=yes
# MARKET_OUTCOME2=no
# MARKET_REWARD=0
# MARKET_REQUIRED_BOND=0
# MINT_AMOUNT_ETH=10000000000000000
